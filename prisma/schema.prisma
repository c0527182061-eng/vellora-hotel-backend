// VELLORA HOTEL – Prisma schema
// כל שינוי בקובץ הזה דורש Migration חדשה: npm run db:migrate

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum RoomType {
  SINGLE
  DOUBLE
  FAMILY
  SUITE
}

enum RoomStatus {
  AVAILABLE
  UNAVAILABLE
}

// הסדר כאן קובע את סדר המיון: ממתינות מופיעות ראשונות
enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings         Booking[] @relation("BookingCustomer")
  decidedBookings  Booking[] @relation("BookingDecider")
}

model Room {
  id            String     @id @default(uuid()) @db.Uuid
  roomNumber    Int        @unique
  name          String     @db.VarChar(100)
  type          RoomType
  pricePerNight Decimal    @db.Decimal(10, 2)
  maxGuests     Int
  floor         Int
  description   String?    @db.VarChar(1000)
  imageKey      String?    @db.VarChar(500)
  status        RoomStatus @default(AVAILABLE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  bookings Booking[]

  @@index([status])
  @@index([type])
}

model Booking {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roomId String? @db.Uuid

  // העתק של פרטי החדר ברגע הבקשה – ההיסטוריה נשמרת גם אם החדר נמחק או המחיר השתנה
  roomNumber    Int
  roomName      String  @db.VarChar(100)
  pricePerNight Decimal @db.Decimal(10, 2)

  checkIn    DateTime      @db.Date
  checkOut   DateTime      @db.Date
  nights     Int
  totalPrice Decimal       @db.Decimal(12, 2)
  guestName  String        @db.VarChar(100)
  phone      String        @db.VarChar(20)
  notes      String?       @db.VarChar(500)
  status     BookingStatus @default(PENDING)

  decidedById String?   @db.Uuid
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User  @relation("BookingCustomer", fields: [userId], references: [id], onDelete: Restrict)
  room      Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  decidedBy User? @relation("BookingDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roomId, status])
  @@index([status, createdAt])
  @@index([checkIn])
}
