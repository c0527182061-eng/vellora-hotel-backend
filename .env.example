# ================================================================
#  VELLORA HOTEL – משתני סביבה
#  העתיקי את הקובץ הזה ל־.env ומלאי ערכים. לעולם אל תעלי .env ל־GitHub!
# ================================================================

# development במחשב, production ב־Render
NODE_ENV=development
PORT=4000

# ---------- מסד נתונים (PostgreSQL) ----------
# במחשב: PostgreSQL מקומי. ב־Render: מחרוזת Session pooler של Supabase (פורט 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vellora_dev
# כמה חיבורים פתוחים במקביל (5 מתאים למסלול החינמי של Supabase)
DATABASE_POOL_MAX=5

# ---------- התחברות (JWT) ----------
# מחרוזת סודית אקראית, לפחות 32 תווים. ב־Render נוצרת אוטומטית
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# תוקף ה־Token: 1d = יום, 12h = 12 שעות
JWT_EXPIRES_IN=1d

# ---------- CORS ----------
# כתובות האתר שלך (React), מופרדות בפסיק. בלי / בסוף
CORS_ORIGINS=http://localhost:5173

# אזור הזמן של המלון (לקביעת "היום")
HOTEL_TIMEZONE=Asia/Jerusalem

# ---------- אחסון תמונות ----------
# r2 = Cloudflare R2 (מומלץ לפרודקשן) | cloudinary = חלופה | local = תיקייה במחשב (פיתוח בלבד)
STORAGE_PROVIDER=local

# Cloudflare R2 (כש־STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vellora-hotel-images
# כתובת ציבורית של ה־bucket, למשל https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=

# Cloudinary (כש־STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vellora-hotel

# local (כש־STORAGE_PROVIDER=local)
LOCAL_UPLOAD_DIR=uploads
# הכתובת של השרת עצמו – לבניית כתובות התמונות המקומיות
PUBLIC_SERVER_URL=http://localhost:4000

# ---------- מנהל ראשון ----------
# בעליית השרת: אם אין משתמש עם האימייל הזה – נוצר מנהל. סיסמה: 8+ תווים, אות וספרה
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=מנהל המלון

# true = מוסיף 8 חדרי הדגמה בעלייה, רק אם עדיין אין אף חדר
SEED_DEMO_ROOMS=false

# בדיקות: כתובת מסד נתונים נפרד לבדיקות (שם שמכיל test)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vellora_test
